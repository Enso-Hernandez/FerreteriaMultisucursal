<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    La cadena de conexión "Ferreteria" está en Conexion.config porque lleva la contraseña
    de SQL Server (contenedor Docker mi_sql_server). Ese archivo NO se sube a Git.
    Para crearlo: copia Conexion.ejemplo.config, renómbralo a Conexion.config
    y escribe tu contraseña.
  -->
  <connectionStrings configSource="Conexion.config" />
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
