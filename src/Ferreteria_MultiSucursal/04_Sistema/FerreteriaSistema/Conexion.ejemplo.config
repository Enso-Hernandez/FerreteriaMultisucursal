<?xml version="1.0" encoding="utf-8"?>
<connectionStrings>
  <!--
    Plantilla de la conexión. Este archivo SÍ se sube a Git (no tiene contraseña).
    1. Copia este archivo y renómbralo a Conexion.config (en esta misma carpeta).
    2. Cambia TU_CONTRASEÑA por la contraseña de "sa" de tu contenedor de SQL Server.
    La base de datos solo funciona si el contenedor está encendido (docker start mi_sql_server).
  -->
  <add name="Ferreteria"
       connectionString="Data Source=localhost,1433;Initial Catalog=Ferreteria;User ID=sa;Password=TU_CONTRASEÑA"
       providerName="System.Data.SqlClient" />
</connectionStrings>
